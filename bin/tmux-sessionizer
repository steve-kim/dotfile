#!/usr/bin/env bash
# Fuzzy-pick a git worktree and switch to its tmux window, creating one if needed.
# Matches by window_start_path (set at creation time) which is stable even if
# the pane's cwd changes later (e.g. when Neovim switches worktrees internally).

get_worktrees() {
  # Use the calling pane's path (passed as $1) to detect git context — the script
  # runs from tmux's default dir (~), not the active pane, so $PWD is unreliable.
  local pane_path="${1:-$PWD}"
  if git -C "$pane_path" rev-parse --git-dir > /dev/null 2>&1; then
    git -C "$pane_path" worktree list --porcelain | awk '/^worktree /{print $2}'
  else
    find "${SESSIONIZER_PATH:-$HOME/code}" -maxdepth 3 -name '.git' 2>/dev/null | xargs -I{} dirname {}
  fi
}

selected=$(get_worktrees "$1" | fzf --prompt='worktree> ' --height=40% --reverse)
[[ -z "$selected" ]] && exit 0

# Find an existing window whose start path matches the selected worktree
existing=$(tmux list-windows -F '#{window_index} #{window_start_path}' 2>/dev/null \
  | awk -v p="$selected" '$2 == p {print $1}')

if [[ -n "$existing" ]]; then
  tmux select-window -t "$existing"
else
  # Create window with nvim in the main pane (55% width)
  tmux new-window -c "$selected" -n "$(basename "$selected")" 'nvim'
  # Split right for claude (45% width)
  tmux split-window -h -p 45 -c "$selected" 'claude'
  # Split the right pane: terminal takes bottom 25%
  tmux split-window -v -p 25 -c "$selected"
  # Focus back on nvim (pane 0)
  tmux select-pane -t 0
fi
